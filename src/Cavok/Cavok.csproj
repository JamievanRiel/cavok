<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Cavok</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Cavok</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jamie van Riel</Authors>
    <Description>METAR and TAF parser for .NET with first-class support for the European ICAO format: CAVOK, QNH in hPa, NOSIG/BECMG/TEMPO trends, FM/BECMG/TEMPO/PROB30/PROB40 change groups and missing values from automatic stations. Precise diagnostics, flight categories and plain-language descriptions in English and Dutch. No dependencies.</Description>
    <PackageTags>metar;taf;speci;aviation;weather;icao;aeronautical;parser;flight-category</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://jamievanriel.github.io/cavok</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/JamievanRiel/cavok/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/JamievanRiel/cavok</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cavok.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
