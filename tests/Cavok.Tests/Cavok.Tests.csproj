<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The tests use the net8.0 build of the library. Build with -p:CavokTestTarget=netstandard2.0 to test the
       netstandard2.0 build instead, the one .NET Framework applications load. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cavok\Cavok.csproj">
      <SetTargetFramework Condition="'$(CavokTestTarget)' != ''">TargetFramework=$(CavokTestTarget)</SetTargetFramework>
    </ProjectReference>
    <AssemblyMetadata Include="CavokTestTarget" Value="$(CavokTestTarget)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Corpus\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
